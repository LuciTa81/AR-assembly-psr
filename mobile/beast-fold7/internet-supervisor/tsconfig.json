{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "esModuleInterop": true, "types": ["node"],
    "skipLibCheck": true, "allowImportingTsExtensions": true
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
