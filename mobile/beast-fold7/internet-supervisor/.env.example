# Never place the service key or database URL in NEXT_PUBLIC variables.
DATABASE_URL=postgresql://ar:replace-me@127.0.0.1:5432/ar_supervisor
OWNER_GITHUB_ID=replace-with-numeric-github-id
SERVICE_KEY=replace-with-32-random-bytes-as-64-hex-characters
WEB_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=8787
MULTI_USER=false
RECORDING_ENABLED=false
# Storage configuration also keeps expiry cleanup running when new capture is off.
# S3_RECORDING_BUCKET=safeops-aiserver-706762893591-ap-northeast-2-an
# AWS_REGION=ap-northeast-2
# Capture requires all limits below after explicit cost approval. No defaults.
# RECORDING_DIRECTORY=/var/lib/ar-assembly/recordings-spool
# RECORDING_FILE_BYTES=
# RECORDING_OWNER_BYTES=
# RECORDING_MAX_SECONDS=
# RECORDING_CONCURRENT=
# Enable only behind one local reverse proxy that overwrites X-Real-IP.
# TRUSTED_PROXY=127.0.0.1
